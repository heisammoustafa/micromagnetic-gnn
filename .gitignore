# Data (large / generated)
ROM_Simulations/
# no trailing slash: also matches a symlink to the data, which "ROM_Simulations/" does not
ROM_Simulations
ROM_Simulations.zip

# Generated figures. Every script writes here; regenerate rather than commit.
figures/

*.pt
*.pkl
*.json
*.png
*.csv
*.tar

# ...except the trained checkpoints every evaluation script loads. They are
# ~1 MB each (weights + config + scaler + history), so the whole set is ~16 MB
# and belongs in the repo: without it none of analysis/ can be reproduced.
!results/*.tar
!results/archive/*.tar
