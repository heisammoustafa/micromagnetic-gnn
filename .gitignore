# Build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Documentation build
docs/_build/

# Jupyter
.ipynb_checkpoints/
#*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
.pytest_cache/
.mypy_cache/
htmlcov/
